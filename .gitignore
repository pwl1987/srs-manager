# Dependencies
node_modules/

# Build artifacts
frontend/dist/

# Test coverage artifacts (generated by npm run test:coverage, read by the delta gate)
coverage/

# Agent working files (plan-mode notes are session artifacts, not product code)
.zcode/plans/

# Operator-local smoke-test target (scripts/e2e-test.js), e.g. the 199 host
scripts/e2e-target.json

# Environment variables
.env

# SQLite database (runtime data)
data/

# Mimosa security tool state
.mimosa/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
.zcodeignore
