{
  "name": "srs-manager-backend",
  "version": "1.0.0",
  "description": "SRS + Wangsu CDN streaming management panel backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js tests/integration/*.test.js",
    "wangsu-sign-test": "node ../scripts/wangsu-sign-test.js",
    "test:coverage": "c8 --all --reporter=json --reporter=text-summary --include='*.js' --include='middleware/**/*.js' --include='routes/**/*.js' --include='services/**/*.js' --include='utils/**/*.js' --exclude='tests/**' node --test tests/*.test.js tests/integration/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
