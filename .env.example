# SRS 接口
SRS_API_URL=http://host.docker.internal:1985/api/v1
# 新版 SRS 可使用 Bearer；非空时优先于 Basic。
SRS_API_TOKEN=
# 当前生产 SRS 6.0.191 使用 Basic；systemd 硬化脚本会自动生成安全密码。
SRS_API_USERNAME=
SRS_API_PASSWORD=

# 默认不把原始 SRS :8080 HLS/HTTP-FLV 地址返回给浏览器。
# 仅可信内网诊断时才临时设为 1；公网分发应使用受保护的反向代理/CDN。
EXPOSE_SRS_HTTP_ORIGIN_URLS=0

# 管理员账户
ADMIN_USER=admin
# 推荐直接使用 ./scripts/deploy.sh：首次部署会自动生成 bcrypt 哈希。
# 如需手工配置，请保留单引号，避免 bcrypt 中的 $ 被 shell/Compose 展开。
ADMIN_PASSWORD_HASH='$2b$10$generated_bcrypt_hash'

# JWT 认证；deploy.sh 会在占位值未替换时自动生成随机密钥。
JWT_SECRET=your_jwt_secret_key
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800

# CORS（多个来源使用英文逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3001
