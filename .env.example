# SRS 接口
SRS_API_URL=http://host.docker.internal:1985/api/v1
SRS_API_TOKEN=your_srs_api_token

# 管理员账户
ADMIN_USER=admin
# 推荐直接使用 ./scripts/deploy.sh：首次部署会自动生成 bcrypt 哈希。
# 如需手工配置，请保留单引号，避免 bcrypt 中的 $ 被 shell/Compose 展开。
ADMIN_PASSWORD_HASH='$2b$10$generated_bcrypt_hash'

# JWT 认证；deploy.sh 会在占位值未替换时自动生成随机密钥。
JWT_SECRET=your_jwt_secret_key
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800

# CORS（多个来源使用英文逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3001
